    <body>
        <header class="header bg-light border-bottom">
            <div class="container d-flex justify-content-between align-items-center py-3">
                @if (companyInfo != null)
                {
                    <a href="/" class="d-flex align-items-center text-dark text-decoration-none">
                        <img src="~/Products/@companyInfo.LogoURL" alt="@companyInfo.Name" class="img-fluid" style="max-height: 50px; margin-right:1rem">
                        <h1 class="ms-3 mb-0">@companyInfo.Name</h1>
                    </a>
                }
            </div>
        </header>

        <h3> WishList </h3>

        <div class="container-fluid">
            @{
                foreach (var product in Model.products)
                {
                    <div class="border rounded d-flex mb-4 p-3 gap-3">
                        <div class="w-25">
                            <img src="~/Products/@product.FeatureImageURL" class="object-fit-cover" />
                        </div>
                        <div class="w-75">
                            <h5>@product.Name</h5>
                            <p>@product.Description</p>
                            <p>@product.Price</p>

                            @foreach (var tag in product.Tags)
                            {
                                <span class="border rounded my-2 p-1">@tag.Name</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>



        <footer class="footer bg-light border-top py-4">
            <div class="container text-center">
                @if (companyInfo != null)
                {
                    <p class="mb-1">&copy; 2024 - @ViewBag.CompanyInfo.Name</p>
                    <p class="mb-1">@companyInfo.Address</p>
                    <p class="mb-1">@companyInfo.EmailAddress</p>
                    <p class="mb-0">@companyInfo.MobileNumber</p>
                }
                else
                {
                    <p class="mb-1">Default Company Name</p>
                    <p class="mb-1">Default Address</p>
                    <p class="mb-1">Default Email</p>
                    <p class="mb-0">Default Mobile Number</p>
                }
            </div>
        </footer>

    </body>
</html>