@model WishlistItemResponseDTO

@{
    ViewBag.Title = "Wishlist Item";
}

<h3> WishList </h3>
<a asp-action="Products" asp-controller="Product"><p>Back To Products</p></a>

<div class="container mb-2">
    @{
        foreach(var product in Model.products)
        {
            <div class="border rounded row d-flex mb-4 p-3">
                <div class="w-25">
                    <img src="/Products/@product.FeatureImageURL" class="wishlistProductmage" />
                </div>
                <div class="w-75">
                    <h5>@product.Name</h5>
                    <p>@product.Description</p>
                    <p>@product.Price</p>   

                    @foreach(var tag in product.Tags)
                    {
                        <span class="border rounded my-2 p-1">@tag.Name</span>
                    }
                </div>
            </div>
        }
    }
    <div>
        @if (Model.products.Any())
        {
            <a asp-action="DownloadWishlist" asp-controller="wishlist"><button class="btn btn-dark"> Download Wishlist </button></a>
        }
        else
        {
            <p class="text-center"> WishList is Empty </p>
        }

    </div>
</div>
