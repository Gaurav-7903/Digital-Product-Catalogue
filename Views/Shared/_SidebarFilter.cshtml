<div class="filter-section">

    <h3 class="my-1 mb-3"> Filter Product </h3>


    <h5>Search</h5>
    <input type="text" id="search-input" class="form-control" placeholder="Search Products">

    <h5>Price Range</h5>
    <div class="d-flex justify-content-around gap-4">
        <input type="number" id="min-price" class="form-control" placeholder="Min Price" min="1">
        <input type="number" id="max-price" class="form-control" placeholder="Max Price" max="@int.MaxValue">
    </div>

    <h5>Tags</h5>
    @foreach (var tag in ViewBag.Tags)
    {
        <div class="form-check">
            <input type="checkbox" class="form-check-input tag-checkbox" value="@tag.Id" id="tag_@tag.Id">
            <label class="form-check-label" for="tag_@tag.Id">@tag.Name</label>
        </div>
    }
</div>

