@model CompanyInfoDTO;

<h1> Add Company Info </h1>

<div class="w-75 mx-auto d-flex flex-column">


    <form asp-action="AddCompany" asp-controller="Company" asp-area="Admin" method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">

            <label asp-for="Name">Product Name</label>
            <input class="form-control" asp-for="Name" placeholder="Enter Company Name">
            <span asp-validation-for="Name" class="danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Information">Information</label>
            <input class="form-control" asp-for="Information" placeholder="Enter Comapny Info">
            <span asp-validation-for="Information" class="danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="EmailAddress">Email Address</label>
            <input class="form-control" asp-for="EmailAddress" placeholder="Enter Email Address">
            <span asp-validation-for="EmailAddress" class="danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Address">Address</label>
            <input class="form-control" asp-for="Address" placeholder="Enter Address">
            <span asp-validation-for="Address" class="danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="MobileNumber">Mobile No</label>
            <input class="form-control" asp-for="MobileNumber" placeholder="Enter Mobile Number">
            <span asp-validation-for="MobileNumber" class="danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Website">Website</label>
            <input class="form-control" asp-for="Website" placeholder="Enter Website URL">
            <span asp-validation-for="Website" class="danger"></span>
        </div>

        <!-- Image Selection -->
        <div class="form-group mb-3">
            <label for="Images">Upload Images</label>
            <input class="form-control" type="file" asp-for="Logo">
            <span asp-validation-for="Logo" class="danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>

        <div asp-validation-summary="All" class="error"></div>

        @if (ViewBag.Errors != null)
        {
            <div class="danger ml">
                <ul>
                    @foreach (string error in ViewBag.Errors)
                    {
                        <li class="ml">@error</li>
                    }
                </ul>
            </div>
        }
    </form>

</div>
