@model IEnumerable<Tag>

@{
    ViewBag.Title = "Add Tag";
}

<div class="w-75 mx-auto d-flex flex-column">
    <form id="AddTagForm">
        <div class="form-group mb-3">
            <label for="Name">Tag Name</label>
            <input class="form-control" id="Name" placeholder="Enter Tag Name">
            <span id="NameError" class="danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Add Tag</button>
    </form>
</div>

<table class="table table-striped shadow-sm p-3 my-2 rounded p-3" id="TagTable">
    <thead>
        <tr>
            <th>Tag ID</th>
            <th>Tag Name</th>
            <th>Create At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in Model)
        {
            <tr>
                <td>@tag.Id</td>
                <td>@tag.Name</td>
                <td>@tag.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#AddTagForm').on('submit', function (event) {

                event.preventDefault();
                console.log("print");
                var tagName = $('#Name').val().trim();
                var nameError = $('#NameError');
                if (!tagName) {
                    nameError.text('Tag Name cannot be empty');
                    return;
                } else {
                    nameError.text('');
                }

                // Make the AJAX request
                $.ajax({
                    url: '@Url.Action("AddTag", "Tag")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Name: tagName }),
                    success: function (response) {
                        if (response && response.tag) {
                            var newRow = $('<tr>').append(
                                $('<td>').text(response.tag.id),
                                $('<td>').text(response.tag.name),
                                $('<td>').text(new Date(response.tag.createdAt).toUTCString()),
                            );
                            $('#TagTable tbody').append(newRow);
                            $('#Name').val('');
                        } else {
                            console.error('Unexpected response format:', response);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error adding tag:', error);
                    }
                });
            });
        });
    </script>

}