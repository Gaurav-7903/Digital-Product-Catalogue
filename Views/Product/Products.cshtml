@using System.Security.Claims;
@model IEnumerable<ProductResponse>

@{
    ViewBag.Tile = "Product";
}

<div class="row">
    <!-- Side Bar For Filter -->
    <aside class="col-md-3 border rounded sidebar">  @await Html.PartialAsync("_SidebarFilter") </aside>
    <input type="hidden" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" id="userId" />

    <div class="col-md-9">
            @if (!User.IsInRole("Admin"))
            {
                <div class="d-flex justify-content-end mb-3">
                    <a asp-action="WishlistItem" asp-controller="Wishlist">
                    <p class="text-center my-auto mr-4" id="wishlistCountIcon"><i class="fa-solid fa-bookmark mr-2"></i><span id="wishlistCount">0</span></p>
                    </a>
                </div>
            
            }
            <div id="prouctList" >
                @await Html.PartialAsync("_ProductList")
            </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="ProductModal" tabindex="-1" role="dialog" aria-labelledby="ProductModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ProductModalTitle">Product Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <img id="modalProductImage" src="" data-zoom-image="" class="img-fluid mb-3 zoom" alt="Product Image" />
                <h5 id="modalProductName"></h5>
                <p id="modalProductDescription"></p>
                <p id="modalProductPrice"></p>


                <!-- Additional Images -->
                <div id="additionalImages" class="mt-3">
                    <h6>Additional Images:</h6>
                    <div class="d-flex gap-2 flex-wrap" id="imageGallery"></div>
                </div>

                <!-- Tags -->
                <div id="productTags" class="mt-3">
                    <h6>Tags:</h6>
                    <ul id="tagList" class=""></ul>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeModal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
     <script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevatezoom.min.js"></script>
 
    <script>

        function initializeZoom() {
            $('#modalProductImage').elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 300,
                zoomContainer: '#ProductModal',
                zoomLevel:3,
                scrollZoom: true,
                zoomWindowHeight: 200,      
                zoomWindowWidth: 200,
                cursor: 'pointer',
            });
            $('#modalProductImage').trigger('mouseover');
        }

        function destroyZoom() {
            var $image = $('#modalProductImage');
            if ($image.data('elevateZoom')) {
                console.log("Destroying Zoom");
                $.removeData($image, 'elevateZoom'); 
                $('.zoomContainer').remove();
                $image.removeData('zoomImage'); 
            }
        }


        $(document).ready(function () {
            const userId = $('#userId').val();
            var timeout;

            // Handle the bookmark icon click
            $('.bookmark-icon').on('click', function () {
                const productId = $(this).data('product-id');
                const userId = $(this).data('user-id');
                console.log(productId, userId);
                const icon = $(this);

                icon.toggleClass('fa-solid');

                let isAdding = icon.hasClass('fa-solid');

                $.ajax({
                    url: isAdding ? '/Wishlist/Add' : '/Wishlist/Remove',
                    type: 'POST',
                    data: JSON.stringify({ productId: productId , UserId : userId }),
                    contentType: 'application/json',
                    success: function (response) {
                        console.log(response.message);
                        if(isAdding){
                            $('#wishlistCount').html(parseInt($("#wishlistCount").text(), 10) + 1);
                        }else{
                            $('#wishlistCount').html(parseInt($("#wishlistCount").text(), 10) - 1);
                        }
                        
                    },
                    error: function () {
                        console.log('Error updating Wishlist.');
                    }
                });
            });

            // Handle Event on input Search and price
            $('#search-input, #min-price, #max-price').on('input', function () {
                clearTimeout(timeout);
                timeout = setTimeout(applyFilter, 2000); // Delay for 1s
            });

            // Handle event on check box 
            $('.tag-checkbox').on('click', function () {
                console.log("Change..")
                applyFilter(userId);
            });

            // Fetching User WishList
            GetUserWishList(userId);

            $("#min-price").on('input', function(){
                console.log(this);
                console.log($("#min-price").val());
                $("#max-price").attr('min', $("#min-price").val())

            })

            $("#max-price").on('input', function () {
                console.log(this);
                console.log($("#max-price").val());
                $("#min-price").attr('max', $("#max-price").val())
            })

            // Close Modal
            $('#closeModal , button.close').on('click', function () {
                $('#ProductModal').modal('hide');
            });
        });

        // Change the feature image when clicking on a gallery image
        $(document).on('click', '.gallery-image', function () {
            var newSrc = $(this).attr('src');
            console.log(newSrc);
            var zoomImageSrc = $(this).attr('data-zoom-image');
            console.log(zoomImageSrc);
            $('#modalProductImage').attr('src', newSrc);
            $('#modalProductImage').attr('data-zoom-image', zoomImageSrc);
            destroyZoom();
            initializeZoom();
        });

        

        // Fetching User Wishlist
        function GetUserWishList(userId) {
            console.log("UserID : ", userId);
            $.ajax({
                url: `/Wishlist/GetWishlistByUserId?userId=${userId}`,
                type: 'GET',
                contentType: 'application/json',
                success: function (response) {
                    console.log("GetUserWishList Response" , response);
                    console.log(parseInt($("#wishlistCount").text(), 10));
                    $('#wishlistCount').html(parseInt($("#wishlistCount").text(), 10) + response.length);

                    $('.card').each(function () {
                        console.log(this);
                        const productId = $(this).find('input[type="hidden"]').val();
                        console.log("In Response : ",productId);
                        if (response.some(item => item.productId == productId)) {
                            console.log("Mathced");
                            $(this).find('.fa-bookmark').addClass('fa-solid');
                        }
                    });

                },
                error: function (error) {
                    console.log(error);
                    //alert('Error Fetching Wishlist.');
                }
            });
        }

        // Applying filter
        function applyFilter(userId) {
            var searchText = $('#search-input').val();
            var minPrice = $('#min-price').val();
            var maxPrice = $('#max-price').val();
            var selectedTags = [];

            $('.tag-checkbox:checked').each(function () {
                selectedTags.push(parseInt($(this).val()));
            });

            var filterData = {
                SearchText: searchText.trim(),
                MinPrice: minPrice ? parseFloat(minPrice) : null, 
                MaxPrice: maxPrice ? parseFloat(maxPrice) : null, 
                TagList: selectedTags.length > 0 ? selectedTags : null 
            };

            console.log("Filter Data:", filterData); 

            $.ajax({
                url: '/Product/FilterProducts',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filterData),
                success: function (response) {
                    console.log(response);
                    $('#prouctList').html(response);
                    GetUserWishList(userId);
                },
                error: function () {
                    alert('Error applying filter');
                }
            });
        }
        
        // Modal (Show Product Details)
        function showDetails(productId) {
            $.ajax({
                url: `/Product/GetProductById?productId=${productId}`,
                type: 'GET',
                contentType: 'application/json',
                success: function (response) {
                    console.log(response.product)
                    console.log(response.product.featureImageURL)
                    // Set the modal content dynamically
                    $('#modalProductImage').attr('src', '/Products/' + response.product.featureImageURL);
                    $('#modalProductName').text(response.product.name);
                    $('#modalProductDescription').text(response.product.description);
                    $('#modalProductPrice').text(response.product.price + 'Rs.');
                    $('#modalProductImage').attr('data-zoom-image', `/Products/${response.product.featureImageURL}`);

                    $('#imageGallery').empty();
                    $('#tagList').empty();

                    // Populate additional images
                    response.product.imagesURL.forEach(function (imageUrl) {
                        $('#imageGallery').append(`<div class=""><img src="/Products/${imageUrl}" data-zoom-image="/Products/${imageUrl}"  class="img-fluid zoom gallery-image" alt="Additional Image"></div>`);
                    });

                    // Populate tags
                    response.product.tags.forEach(function (tag) {
                        $('#tagList').append(`<li>${tag.name}</li>`);
                    });

                    destroyZoom();
                    initializeZoom();
                    // Show the modal
                    $('#ProductModal').modal('show');
                   
                },
                error: function () {
                    alert('Error fetching product details.');
                }
            });
        }
    </script>

}
